{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanskrit Bruno Memory World",
  "type": "object",
  "required": [
    "version",
    "kind",
    "source",
    "generatedAt",
    "associations",
    "wheelStates"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "kind": {
      "const": "sanskrit-memory-world"
    },
    "source": {
      "const": "sanskrithelp-bruno"
    },
    "generatedAt": {
      "type": "string"
    },
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "primitiveId"
        ],
        "properties": {
          "primitiveId": {
            "type": "string"
          },
          "colour": {
            "type": "string"
          },
          "emotion": {
            "type": "string"
          },
          "bodyLocation": {
            "type": "string"
          },
          "rhythm": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "motion": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "sourceAttested": {
            "type": "boolean"
          }
        }
      }
    },
    "wheelStates": {
      "type": "array"
    },
    "nightHandoff": {
      "type": "object",
      "properties": {
        "installed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "soundSequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recallPrompt": {
          "type": "string"
        },
        "dreamPrompt": {
          "type": "string"
        },
        "provenanceNote": {
          "type": "string"
        }
      }
    }
  }
}